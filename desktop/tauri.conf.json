{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minefield",
  "version": "1.5.0",
  "identifier": "com.minefield.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/build-native-web.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minefield",
        "width": 1180,
        "height": 860,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "Minesweeper with nine ways to play",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pulseaudio"
        ]
      }
    }
  }
}
