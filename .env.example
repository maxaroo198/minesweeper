# Public leaderboard (optional). Copy this file to .env and fill in your own
# Firebase web-app config — see FIREBASE-SETUP.md for the five-minute walkthrough.
# Without it the game runs exactly as before, with local-only leaderboards.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional — inferred from the project id when omitted
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
